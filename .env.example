# Public base URL for the pre-wedding images bucket.
# Example: https://PROJECT_REF.supabase.co/storage/v1/object/public/pre-wedding
NEXT_PUBLIC_SUPABASE_STORAGE_PUBLIC_BASE_URL=

# Server-only Google Sheets API settings for RSVP submissions.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=RSVP
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional override for the maximum number of attendees in one RSVP.
MAX_ATTENDEE_COUNT=10
