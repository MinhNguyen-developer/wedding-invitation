# Public browser-safe Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Public browser-safe Supabase anon or publishable key, if needed by future browser-safe features.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public base URL for the pre-wedding images bucket.
# Example: https://PROJECT_REF.supabase.co/storage/v1/object/public/pre-wedding
NEXT_PUBLIC_SUPABASE_STORAGE_PUBLIC_BASE_URL=

# Server-only key used by the RSVP route. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional override for the maximum number of attendees in one RSVP.
MAX_ATTENDEE_COUNT=10
